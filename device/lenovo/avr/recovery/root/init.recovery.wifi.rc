# AERA Wi-Fi startup for avr (Lenovo Legion Y70, WCN7750).
# Kernel-matched WLAN modules are staged from vendor_dlkm after decryption;
# AERA supplies the supplicant, CLI and DHCP userspace itself.

on property:post.decrypt.modules=true
    setprop sys.aera.wlan.up 0
    start aera-wlan-ready

on property:wifi.driver.ready=true
    mkdir /tmp/recovery 0755 root root
    mkdir /tmp/recovery/sockets 0750 root wifi
    copy /system/etc/wifi/northstar-supplicant.conf /tmp/northstar-wpa.conf
    start wpa_supplicant

on property:sys.aera.wlan.up=1 && property:wifi.driver.ready=true
    setprop sys.aera.wlan.up 0
    mkdir /tmp/recovery 0755 root root
    mkdir /tmp/recovery/sockets 0750 root wifi
    copy /system/etc/wifi/northstar-supplicant.conf /tmp/northstar-wpa.conf
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -O/tmp/recovery/sockets -c/tmp/northstar-wpa.conf
    disabled
    user root
    group root wifi inet
    seclabel u:r:recovery:s0

service aera-wlan-ready /system/bin/sh /system/bin/northstar-wlan-ready.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
